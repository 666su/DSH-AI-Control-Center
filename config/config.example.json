{
  "_说明": "请把本文件复制为 config.json 并填写你自己的值；带 YOUR_ 前缀的是必须/可选更改项。安全加固：dsh.proxyHosts 填 DSH Web 的公网子域名数组（如 [dsh.YOUR_DOMAIN]）时，这些域名会自动走控制中心的受保护代理（必须登录控制中心才能访问 DSH）；server.cookieDomain 填 .YOUR_DOMAIN 让子域名共享登录 cookie；server.publicUrl 填控制中心自身公网地址。dsh.serviceName 填 NSSM 服务名（如 DeepSeekHarness）后，启停走 net start/stop（服务化部署推荐），留空则走 npx 直接启动。",
  "server": {
    "port": 3081,
    "host": "0.0.0.0",
    "token": "",
    "cookieDomain": "",
    "publicUrl": ""
  },
  "dsh": {
    "webUrl": "http://127.0.0.1:3080",
    "port": 3080,
    "logFile": "E:\\YOUR_WORKSPACE\\dsh.log",
    "startCommand": "npx --yes @deepseek-ai/dsh web --no-open",
    "startCwd": "E:\\YOUR_WORKSPACE",
    "healthTimeoutMs": 2000,
    "publicUrl": "",
    "userProfile": "C:\\Users\\YOUR_USERNAME",
    "proxyHost": "",
    "proxyHosts": [],
    "serviceName": ""
  },
  "monitor": {
    "intervalMs": 5000,
    "historyRetentionHours": 48,
    "tempAlert": {
      "enabled": true,
      "gpuC": 80,
      "cpuC": 90,
      "hysteresisC": 3,
      "repeatMs": 1800000
    }
  },
  "recovery": {
    "intervalMs": 30000,
    "autoRestart": true,
    "failThreshold": 3,
    "bootGraceMs": 90000,
    "processYoungMs": 30000,
    "launchWaitMs": 60000,
    "cooldownsMs": [
      30000,
      60000,
      120000
    ],
    "maxAttempts": 3
  },
  "lhm": {
    "url": "http://127.0.0.1:8085/data.json",
    "timeoutMs": 1500
  },
  "tasks": {
    "defaultWorkspace": "E:\\YOUR_WORKSPACE"
  },
  "notify": {
    "enabled": false,
    "channels": []
  }
}